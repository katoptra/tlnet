# Read by every aws call through AWS_CONFIG_FILE, which the Taskfile's env: sets. The CLI's
# default multipart threshold is 8 MB; the largest tlnet file is ~145 MB, so this keeps every
# upload one PutObject. R2 answers a burst of writes with 503 now and then; standard retry
# mode backs off and tries again, ten times, as the other mirrors do.
[default]
retry_mode = standard
max_attempts = 10
s3 =
    multipart_threshold = 200MB
    max_concurrent_requests = 32
